+constexpr uint32_t kTagMemory = ps2_savestate::makeTag('P', 'M', 'E', '1');
+constexpr uint32_t kTagRegisters = ps2_savestate::makeTag('P', 'R', 'E', 'G');
+constexpr uint32_t kTagRuntime = ps2_savestate::makeTag('P', 'R', 'T', '1');
+constexpr uint32_t kTagIop = ps2_savestate::makeTag('P', 'I', 'O', 'P');
+
+// The memories and registers the guest can see. The pending transfer lists and
+// the masked PATH3 FIFO must be empty (the VIF1 thread has drained by the time
+// this runs); a half-done transfer fails the save and the caller asks again.
+bool saveMemory(PS2Memory &memory, ps2_savestate::Writer &out, std::string &whyNot)
+{
+    if (!memory.m_pendingGifTransfers.empty() || !memory.m_pendingVif0Transfers.empty() ||
+        !memory.m_pendingVif1Transfers.empty())
+    {
+        whyNot = "a DMA transfer is pending";
+        return false;
+    }
+    if (!memory.m_path3MaskedFifo.empty())
+    {
+        whyNot = "the masked PATH3 FIFO holds data";
+        return false;
+    }
+    memory.settleEeTimers();
+
+    out.tag(kTagMemory);
+    out.bytes(memory.m_rdram, PS2_RAM_SIZE);
+    out.bytes(memory.m_scratchpad, PS2_SCRATCHPAD_SIZE);
+    out.bytes(memory.m_gsVRAM, PS2_GS_VRAM_SIZE);
+    out.bytes(memory.m_vu0Code, PS2_VU0_CODE_SIZE);
+    out.bytes(memory.m_vu0Data, PS2_VU0_DATA_SIZE);
+    out.bytes(memory.m_vu1Code, PS2_VU1_CODE_SIZE);
+    out.bytes(memory.m_vu1Data, PS2_VU1_DATA_SIZE);
+
+    out.tag(kTagRegisters);
+    out.put<uint32_t>(static_cast<uint32_t>(memory.m_ioRegisters.size()));
+    for (const auto &[address, value] : memory.m_ioRegisters)
+    {
+        out.put<uint32_t>(address);
+        out.put<uint32_t>(value);
+    }
+    // GSRegisters holds two atomics; written as the plain words they are.
+    const uint64_t *gsWords = reinterpret_cast<const uint64_t *>(&memory.gs_regs);
+    for (size_t i = 0; i < sizeof(GSRegisters) / sizeof(uint64_t); ++i)
+        out.put<uint64_t>(gsWords[i]);
+    out.put(memory.vif0_regs);
+    out.put(memory.vif1_regs);
+    for (const DMARegisters &dma : memory.dma_regs)
+        out.put(dma);
+    out.put<uint32_t>(static_cast<uint32_t>(memory.m_tlbEntries.size()));
+    for (const PS2Memory::TLBEntry &entry : memory.m_tlbEntries)
+    {
+        out.put<uint32_t>(entry.vpn);
+        out.put<uint32_t>(entry.pfn);
+        out.put<uint32_t>(entry.mask);
+        out.put<uint8_t>(entry.valid ? 1u : 0u);
+    }
+    out.put<uint8_t>(memory.m_path3Masked ? 1u : 0u);
+    out.put<uint32_t>(memory.m_vif1PendingPath2ImageQwc);
+    out.put<uint8_t>(memory.m_vif1PendingPath2DirectHl ? 1u : 0u);
+    for (const PS2Memory::EeTimer &timer : memory.m_eeTimers)
+        out.put(timer);
+    return true;
+}
+
+void loadMemory(PS2Memory &memory, ps2_savestate::Reader &in)
+{
+    in.expectTag(kTagMemory);
+    in.bytes(memory.m_rdram, PS2_RAM_SIZE);
+    in.bytes(memory.m_scratchpad, PS2_SCRATCHPAD_SIZE);
+    in.bytes(memory.m_gsVRAM, PS2_GS_VRAM_SIZE);
+    in.bytes(memory.m_vu0Code, PS2_VU0_CODE_SIZE);
+    in.bytes(memory.m_vu0Data, PS2_VU0_DATA_SIZE);
+    in.bytes(memory.m_vu1Code, PS2_VU1_CODE_SIZE);
+    in.bytes(memory.m_vu1Data, PS2_VU1_DATA_SIZE);
+
+    in.expectTag(kTagRegisters);
+    memory.m_ioRegisters.clear();
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        const uint32_t address = in.get<uint32_t>();
+        memory.m_ioRegisters[address] = in.get<uint32_t>();
+    }
+    uint64_t *gsWords = reinterpret_cast<uint64_t *>(&memory.gs_regs);
+    for (size_t i = 0; i < sizeof(GSRegisters) / sizeof(uint64_t); ++i)
+        gsWords[i] = in.get<uint64_t>();
+    memory.vif0_regs = in.get<VIFRegisters>();
+    memory.vif1_regs = in.get<VIFRegisters>();
+    for (DMARegisters &dma : memory.dma_regs)
+        dma = in.get<DMARegisters>();
+    memory.m_tlbEntries.clear();
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        PS2Memory::TLBEntry entry{};
+        entry.vpn = in.get<uint32_t>();
+        entry.pfn = in.get<uint32_t>();
+        entry.mask = in.get<uint32_t>();
+        entry.valid = in.get<uint8_t>() != 0u;
+        memory.m_tlbEntries.push_back(entry);
+    }
+    memory.m_path3Masked = in.get<uint8_t>() != 0u;
+    memory.m_vif1PendingPath2ImageQwc = in.get<uint32_t>();
+    memory.m_vif1PendingPath2DirectHl = in.get<uint8_t>() != 0u;
+    for (PS2Memory::EeTimer &timer : memory.m_eeTimers)
+        timer = in.get<PS2Memory::EeTimer>();
+    memory.refreshEeTimersCued();
+
+    memory.m_pendingGifTransfers.clear();
+    memory.m_pendingVif0Transfers.clear();
+    memory.m_pendingVif1Transfers.clear();
+    memory.m_path3MaskedFifo.clear();
+    {
+        std::lock_guard lock(memory.m_completedDmacMutex);
+        memory.m_completedDmacCauses.clear();
+    }
+    // Everything cached from the VU code is stale.
+    memory.markVU0CodeModified();
+    memory.markVU1CodeModified();
+}
