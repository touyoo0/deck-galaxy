     }
+    bool NativeIop::saveState(std::vector<uint8_t> &out, std::string &whyNot)
+    {
+        std::lock_guard lock(m_impl->mutex);
+        out.clear();
+        if (!m_impl->loaded)
+            return true;
+        lle::StateWriter writer;
+        if (!m_impl->iop.saveState(writer, whyNot))
+            return false;
+        out = std::move(writer.buffer());
+        return true;
+    }
+
+    void NativeIop::loadState(const uint8_t *data, size_t size)
+    {
+        {
+            std::lock_guard lock(m_impl->mutex);
+            lle::StateReader reader(data, size);
+            m_impl->iop.loadState(reader);
+            m_impl->loaded = m_impl->iop.moduleCount() != 0u;
+        }
+        m_impl->progressed.notify_all();
+    }
 }
