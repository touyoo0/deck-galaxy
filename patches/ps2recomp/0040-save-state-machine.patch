+// ---------------------------------------------------------------------------
+// Save states
+//
+// A guest thread is restorable from its R5900Context alone when it is waiting
+// to be dispatched at a pc the generated code can re-enter (every function
+// starts with a switch on ctx->pc that jumps to the labels after its calls and
+// syscalls). A thread parked on its fiber inside a syscall has that pc: the
+// generated code stores the address after the syscall before calling the
+// handler, and the handlers that park (WaitSema, SleepThread, WaitEventFlag,
+// and the yield at the end of SignalSema and the like) set the result before
+// they park and do nothing after. Its C++ stack holds nothing the context does
+// not, so a restore drops the fiber and dispatches the pc, as for a thread a
+// checkpoint unwound.
+namespace
+{
+using ps2_savestate::makeTag;
+using ps2_savestate::Reader;
+using ps2_savestate::SaveStateError;
+using ps2_savestate::Writer;
+
+constexpr uint32_t kTagScheduler = makeTag('E', 'E', 'S', '1');
+constexpr uint32_t kTagThreads = makeTag('T', 'H', 'R', 'D');
+constexpr uint32_t kTagObjects = makeTag('O', 'B', 'J', 'S');
+constexpr uint32_t kTagEvents = makeTag('E', 'V', 'N', 'T');
+constexpr uint32_t kSyscallWord = 0x0000000Cu;
+
+void putDeque(Writer &out, const std::deque<int> &queue)
+{
+    out.put<uint32_t>(static_cast<uint32_t>(queue.size()));
+    for (const int value : queue)
+        out.put<int32_t>(value);
+}
+
+void getDeque(Reader &in, std::deque<int> &queue)
+{
+    queue.clear();
+    const uint32_t count = in.get<uint32_t>();
+    if (count > 65536u)
+        throw SaveStateError("save state queue is implausibly long");
+    for (uint32_t i = 0; i < count; ++i)
+        queue.push_back(in.get<int32_t>());
+}
+
+void putWait(Writer &out, const EeWaitState &wait)
+{
+    out.put<uint8_t>(static_cast<uint8_t>(wait.reason));
+    out.put<uint32_t>(static_cast<uint32_t>(wait.payload.index()));
+    switch (wait.payload.index())
+    {
+    case 1:
+        out.put(std::get<EeSemaphoreWait>(wait.payload));
+        break;
+    case 2:
+        out.put(std::get<EeEventFlagWait>(wait.payload));
+        break;
+    case 3:
+        out.put(std::get<EeVSyncWait>(wait.payload));
+        break;
+    case 4:
+        out.put(std::get<EeExternalWait>(wait.payload));
+        break;
+    default:
+        break;
+    }
+}
+
+void getWait(Reader &in, EeWaitState &wait)
+{
+    wait = {};
+    wait.reason = static_cast<EeWaitReason>(in.get<uint8_t>());
+    switch (in.get<uint32_t>())
+    {
+    case 1:
+        wait.payload = in.get<EeSemaphoreWait>();
+        break;
+    case 2:
+        wait.payload = in.get<EeEventFlagWait>();
+        break;
+    case 3:
+        wait.payload = in.get<EeVSyncWait>();
+        break;
+    case 4:
+        wait.payload = in.get<EeExternalWait>();
+        break;
+    default:
+        break;
+    }
+}
+} // namespace
+
+void EeScheduler::requestExecutorTask(std::function<bool()> task)
+{
+    {
+        std::lock_guard lock(m_taskMutex);
+        m_tasks.push_back(std::move(task));
+        m_taskCount.store(static_cast<uint32_t>(m_tasks.size()), std::memory_order_release);
+    }
+    // Wake an idle executor: an external wake that no wait matches.
+    postEvent(EeEvent{EeEventType::ExternalWake, 0xFFFFFFFFu, 0xFFFFFFFFFFFFFFFFull});
+}
+
+void EeScheduler::runExecutorTasks()
+{
+    assertExecutor();
+    std::vector<std::function<bool()>> tasks;
+    {
+        std::lock_guard lock(m_taskMutex);
+        tasks.swap(m_tasks);
+        m_taskCount.store(0u, std::memory_order_release);
+    }
+    std::vector<std::function<bool()>> again;
+    for (auto &task : tasks)
+    {
+        bool done = true;
+        try
+        {
+            done = task();
+        }
+        catch (const std::exception &error)
+        {
+            std::fprintf(stderr, "[savestate] task failed: %s\n", error.what());
+        }
+        if (!done)
+            again.push_back(std::move(task));
+    }
+    if (!again.empty())
+    {
+        std::lock_guard lock(m_taskMutex);
+        for (auto &task : again)
+            m_tasks.push_back(std::move(task));
+        m_taskCount.store(static_cast<uint32_t>(m_tasks.size()), std::memory_order_release);
+    }
+}
+
+bool EeScheduler::saveState(Writer &out, std::string &whyNot)
+{
+    assertExecutor();
+    char text[160];
+    if (m_activeFiber != nullptr)
+    {
+        whyNot = "inside a guest call";
+        return false;
+    }
+    if (!m_pendingInvocations.empty())
+    {
+        whyNot = "an interrupt callback is queued";
+        return false;
+    }
+    {
+        std::lock_guard lock(m_eventMutex);
+        if (!m_events.empty())
+        {
+            // Posted by another thread and not serviced yet; the next pass
+            // takes them, then this save asks again.
+            whyNot = "events are waiting to be processed";
+            return false;
+        }
+    }
+    for (const auto &[id, thread] : m_threads)
+    {
+        if (!thread.invocations.empty())
+        {
+            std::snprintf(text, sizeof(text), "thread %d is inside a callback", id);
+            whyNot = text;
+            return false;
+        }
+        if (thread.wait.completion || thread.resumeCompletion)
+        {
+            std::snprintf(text, sizeof(text), "thread %d waits with a completion (pc %08X)", id, thread.context.pc);
+            whyNot = text;
+            return false;
+        }
+        if (thread.inGuestCall)
+        {
+            // The fiber stands inside a syscall handler: the word before the
+            // saved pc must be the syscall instruction.
+            const uint32_t pc = thread.context.pc & PS2_RAM_MASK;
+            uint32_t before = 0u;
+            if (pc >= 4u)
+                std::memcpy(&before, m_rdram + pc - 4u, sizeof(before));
+            if (before != kSyscallWord)
+            {
+                std::snprintf(text, sizeof(text), "thread %d is parked outside a syscall (pc %08X)", id, thread.context.pc);
+                whyNot = text;
+                return false;
+            }
+        }
+    }
+
+    out.tag(kTagScheduler);
+    out.put<int32_t>(m_nextThreadId);
+    out.put<int32_t>(m_nextInvocationThreadId);
+    out.put<int32_t>(m_nextSemaphoreId);
+    out.put<int32_t>(m_nextEventFlagId);
+    out.put<int32_t>(m_nextAlarmId);
+    out.put<int32_t>(m_nextIntcHandlerId);
+    out.put<int32_t>(m_nextDmacHandlerId);
+    out.put<int32_t>(m_intcHeadOrder);
+    out.put<int32_t>(m_intcTailOrder);
+    out.put<int32_t>(m_dmacHeadOrder);
+    out.put<int32_t>(m_dmacTailOrder);
+    out.put<uint32_t>(m_enabledIntcMask);
+    out.put<uint32_t>(m_enabledDmacMask);
+    out.put<uint32_t>(m_pendingIntcMask);
+    out.put<uint32_t>(m_pendingDmacMask);
+    out.put<int32_t>(m_currentThreadId);
+    out.put<int32_t>(m_lastRunThreadId);
+    out.put<uint8_t>(m_rescheduleRequested ? 1u : 0u);
+    out.put<uint8_t>(m_timeSliceExpired ? 1u : 0u);
+    out.put<uint32_t>(m_pendingEeTimerInterrupts);
+    out.put<uint64_t>(m_eeCycle);
+    out.put<uint64_t>(m_sliceEndCycle);
+    out.put<uint64_t>(m_eventSequence);
+    out.put<uint64_t>(m_invocationSequence);
+    out.put<uint64_t>(m_vsyncTick);
+    out.put<uint32_t>(m_vsyncFlagAddress);
+    out.put<uint32_t>(m_vsyncTickAddress);
+    out.put<uint32_t>(m_gsVSyncCallback);
+    out.put<uint32_t>(m_gsVSyncCallbackGp);
+    out.put<uint32_t>(m_gsVSyncCallbackSp);
+
+    out.tag(kTagThreads);
+    out.put<uint32_t>(static_cast<uint32_t>(m_threads.size()));
+    for (const auto &[id, thread] : m_threads)
+    {
+        out.put<int32_t>(id);
+        out.put(thread.context);
+        out.put<uint32_t>(thread.entry);
+        out.put<uint32_t>(thread.stack);
+        out.put<uint32_t>(thread.stackSize);
+        out.put<uint32_t>(thread.gp);
+        out.put<uint32_t>(thread.attr);
+        out.put<uint32_t>(thread.option);
+        out.put<uint32_t>(thread.arg);
+        out.put<int32_t>(thread.initialPriority);
+        out.put<int32_t>(thread.currentPriority);
+        out.put<uint8_t>(static_cast<uint8_t>(thread.status));
+        out.put<int32_t>(thread.suspendCount);
+        out.put<uint32_t>(thread.wakeupCount);
+        out.put<uint8_t>(thread.ownsStack ? 1u : 0u);
+        out.put<uint32_t>(thread.tlsBase);
+        putWait(out, thread.wait);
+    }
+    uint32_t nonEmptyQueues = 0u;
+    for (const auto &queue : m_readyQueues)
+        nonEmptyQueues += queue.empty() ? 0u : 1u;
+    out.put<uint32_t>(nonEmptyQueues);
+    for (int priority = 0; priority < kPriorityCount; ++priority)
+    {
+        if (m_readyQueues[static_cast<size_t>(priority)].empty())
+            continue;
+        out.put<int32_t>(priority);
+        putDeque(out, m_readyQueues[static_cast<size_t>(priority)]);
+    }
+
+    out.tag(kTagObjects);
+    out.put<uint32_t>(static_cast<uint32_t>(m_semaphores.size()));
+    for (const auto &[id, sema] : m_semaphores)
+    {
+        out.put<int32_t>(id);
+        out.put<int32_t>(sema.count);
+        out.put<int32_t>(sema.maxCount);
+        out.put<int32_t>(sema.initCount);
+        out.put<uint32_t>(sema.attr);
+        out.put<uint32_t>(sema.option);
+        putDeque(out, sema.waiters);
+    }
+    out.put<uint32_t>(static_cast<uint32_t>(m_eventFlags.size()));
+    for (const auto &[id, flag] : m_eventFlags)
+    {
+        out.put<int32_t>(id);
+        out.put<uint32_t>(flag.attr);
+        out.put<uint32_t>(flag.option);
+        out.put<uint32_t>(flag.initBits);
+        out.put<uint32_t>(flag.bits);
+        putDeque(out, flag.waiters);
+    }
+    out.put<uint32_t>(static_cast<uint32_t>(m_alarms.size()));
+    for (const auto &[id, alarm] : m_alarms)
+    {
+        out.put<int32_t>(id);
+        out.put(alarm);
+    }
+    out.put<uint32_t>(static_cast<uint32_t>(m_intcHandlers.size()));
+    for (const auto &[id, handler] : m_intcHandlers)
+    {
+        out.put<int32_t>(id);
+        out.put(handler);
+    }
+    out.put<uint32_t>(static_cast<uint32_t>(m_dmacHandlers.size()));
+    for (const auto &[id, handler] : m_dmacHandlers)
+    {
+        out.put<int32_t>(id);
+        out.put(handler);
+    }
+    out.put<uint32_t>(static_cast<uint32_t>(m_invocationStackTops.size()));
+    for (const auto &[key, top] : m_invocationStackTops)
+    {
+        out.put<uint64_t>(key);
+        out.put<uint32_t>(top);
+    }
+    out.put<uint32_t>(static_cast<uint32_t>(m_freeInvocationStacks.size()));
+    for (const uint32_t top : m_freeInvocationStacks)
+        out.put<uint32_t>(top);
+
+    // Deadlines carry a host time: saved as the time left, put back against
+    // the pacing clock of the moment, so a load does not fire them all at once
+    // or leave them hours away.
+    out.tag(kTagEvents);
+    {
+        std::lock_guard lock(m_eventMutex);
+        const auto now = pacingNow();
+        out.put<uint32_t>(static_cast<uint32_t>(m_deadlines.size()));
+        for (const ScheduledEvent &scheduled : m_deadlines)
+        {
+            const int64_t leftNs = std::max<int64_t>(
+                0, std::chrono::duration_cast<std::chrono::nanoseconds>(scheduled.hostDeadline - now).count());
+            out.put<uint64_t>(scheduled.deadlineCycle);
+            out.put<int64_t>(leftNs);
+            out.put(scheduled.event);
+            out.put<uint64_t>(scheduled.sequence);
+        }
+    }
+    return true;
+}
+
+void EeScheduler::loadState(Reader &in)
+{
+    assertExecutor();
+    in.expectTag(kTagScheduler);
+
+    // Nothing is touched until the stream has been read whole into locals, so
+    // a bad file leaves the running scheduler alone.
+    const int32_t nextThreadId = in.get<int32_t>();
+    const int32_t nextInvocationThreadId = in.get<int32_t>();
+    const int32_t nextSemaphoreId = in.get<int32_t>();
+    const int32_t nextEventFlagId = in.get<int32_t>();
+    const int32_t nextAlarmId = in.get<int32_t>();
+    const int32_t nextIntcHandlerId = in.get<int32_t>();
+    const int32_t nextDmacHandlerId = in.get<int32_t>();
+    const int32_t intcHeadOrder = in.get<int32_t>();
+    const int32_t intcTailOrder = in.get<int32_t>();
+    const int32_t dmacHeadOrder = in.get<int32_t>();
+    const int32_t dmacTailOrder = in.get<int32_t>();
+    const uint32_t enabledIntcMask = in.get<uint32_t>();
+    const uint32_t enabledDmacMask = in.get<uint32_t>();
+    const uint32_t pendingIntcMask = in.get<uint32_t>();
+    const uint32_t pendingDmacMask = in.get<uint32_t>();
+    const int32_t currentThreadId = in.get<int32_t>();
+    const int32_t lastRunThreadId = in.get<int32_t>();
+    const bool rescheduleRequested = in.get<uint8_t>() != 0u;
+    const bool timeSliceExpired = in.get<uint8_t>() != 0u;
+    const uint32_t pendingEeTimerInterrupts = in.get<uint32_t>();
+    const uint64_t eeCycle = in.get<uint64_t>();
+    const uint64_t sliceEndCycle = in.get<uint64_t>();
+    const uint64_t eventSequence = in.get<uint64_t>();
+    const uint64_t invocationSequence = in.get<uint64_t>();
+    const uint64_t vsyncTick = in.get<uint64_t>();
+    const uint32_t vsyncFlagAddress = in.get<uint32_t>();
+    const uint32_t vsyncTickAddress = in.get<uint32_t>();
+    const uint32_t gsVSyncCallback = in.get<uint32_t>();
+    const uint32_t gsVSyncCallbackGp = in.get<uint32_t>();
+    const uint32_t gsVSyncCallbackSp = in.get<uint32_t>();
+
+    in.expectTag(kTagThreads);
+    std::unordered_map<int, GuestThread> threads;
+    const uint32_t threadCount = in.get<uint32_t>();
+    if (threadCount > 4096u)
+        throw SaveStateError("save state has too many threads");
+    for (uint32_t i = 0; i < threadCount; ++i)
+    {
+        GuestThread thread{};
+        thread.id = in.get<int32_t>();
+        thread.context = in.get<R5900Context>();
+        thread.entry = in.get<uint32_t>();
+        thread.stack = in.get<uint32_t>();
+        thread.stackSize = in.get<uint32_t>();
+        thread.gp = in.get<uint32_t>();
+        thread.attr = in.get<uint32_t>();
+        thread.option = in.get<uint32_t>();
+        thread.arg = in.get<uint32_t>();
+        thread.initialPriority = in.get<int32_t>();
+        thread.currentPriority = in.get<int32_t>();
+        thread.status = static_cast<EeThreadStatus>(in.get<uint8_t>());
+        thread.suspendCount = in.get<int32_t>();
+        thread.wakeupCount = in.get<uint32_t>();
+        thread.ownsStack = in.get<uint8_t>() != 0u;
+        thread.tlsBase = in.get<uint32_t>();
+        getWait(in, thread.wait);
+        const int id = thread.id;
+        threads.emplace(id, std::move(thread));
+    }
+    std::array<std::deque<int>, kPriorityCount> readyQueues{};
+    const uint32_t queueCount = in.get<uint32_t>();
+    for (uint32_t i = 0; i < queueCount; ++i)
+    {
+        const int32_t priority = in.get<int32_t>();
+        if (priority < 0 || priority >= kPriorityCount)
+            throw SaveStateError("save state ready queue has a bad priority");
+        getDeque(in, readyQueues[static_cast<size_t>(priority)]);
+    }
+
+    in.expectTag(kTagObjects);
+    std::unordered_map<int, EeSemaphore> semaphores;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        EeSemaphore sema{};
+        sema.id = in.get<int32_t>();
+        sema.count = in.get<int32_t>();
+        sema.maxCount = in.get<int32_t>();
+        sema.initCount = in.get<int32_t>();
+        sema.attr = in.get<uint32_t>();
+        sema.option = in.get<uint32_t>();
+        getDeque(in, sema.waiters);
+        const int id = sema.id;
+        semaphores.emplace(id, std::move(sema));
+    }
+    std::unordered_map<int, EeEventFlag> eventFlags;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        EeEventFlag flag{};
+        flag.id = in.get<int32_t>();
+        flag.attr = in.get<uint32_t>();
+        flag.option = in.get<uint32_t>();
+        flag.initBits = in.get<uint32_t>();
+        flag.bits = in.get<uint32_t>();
+        getDeque(in, flag.waiters);
+        const int id = flag.id;
+        eventFlags.emplace(id, std::move(flag));
+    }
+    std::unordered_map<int, EeAlarm> alarms;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        const int id = in.get<int32_t>();
+        alarms.emplace(id, in.get<EeAlarm>());
+    }
+    std::unordered_map<int, EeIrqHandler> intcHandlers;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        const int id = in.get<int32_t>();
+        intcHandlers.emplace(id, in.get<EeIrqHandler>());
+    }
+    std::unordered_map<int, EeIrqHandler> dmacHandlers;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        const int id = in.get<int32_t>();
+        dmacHandlers.emplace(id, in.get<EeIrqHandler>());
+    }
+    std::unordered_map<uint64_t, uint32_t> invocationStackTops;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        const uint64_t key = in.get<uint64_t>();
+        invocationStackTops.emplace(key, in.get<uint32_t>());
+    }
+    std::vector<uint32_t> freeInvocationStacks;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+        freeInvocationStacks.push_back(in.get<uint32_t>());
+
+    in.expectTag(kTagEvents);
+    struct SavedDeadline
+    {
+        uint64_t deadlineCycle;
+        int64_t leftNs;
+        EeEvent event;
+        uint64_t sequence;
+    };
+    std::vector<SavedDeadline> deadlines;
+    for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+    {
+        SavedDeadline saved{};
+        saved.deadlineCycle = in.get<uint64_t>();
+        saved.leftNs = in.get<int64_t>();
+        saved.event = in.get<EeEvent>();
+        saved.sequence = in.get<uint64_t>();
+        deadlines.push_back(saved);
+    }
+
+    // Past this point nothing can fail. The old threads' fibers are dropped
+    // without unwinding: their C++ frames hold nothing the guest state needs.
+    m_exitedThread = {};
+    m_threads.clear();
+    m_threadIndex.fill(nullptr);
+    m_threads = std::move(threads);
+    for (auto &[id, thread] : m_threads)
+    {
+        thread.fiber.reset();
+        thread.inGuestCall = false;
+        if (id > 0 && id <= kLastThreadId)
+            m_threadIndex[static_cast<size_t>(id)] = &thread;
+    }
+    m_readyQueues = std::move(readyQueues);
+    m_readyMask.fill(0u);
+    for (int priority = 0; priority < kPriorityCount; ++priority)
+        refreshReadyMask(priority);
+    m_semaphores = std::move(semaphores);
+    m_eventFlags = std::move(eventFlags);
+    m_alarms = std::move(alarms);
+    m_intcHandlers = std::move(intcHandlers);
+    m_dmacHandlers = std::move(dmacHandlers);
+    m_invocationStackTops = std::move(invocationStackTops);
+    m_freeInvocationStacks = std::move(freeInvocationStacks);
+
+    m_nextThreadId = nextThreadId;
+    m_nextInvocationThreadId = nextInvocationThreadId;
+    m_nextSemaphoreId = nextSemaphoreId;
+    m_nextEventFlagId = nextEventFlagId;
+    m_nextAlarmId = nextAlarmId;
+    m_nextIntcHandlerId = nextIntcHandlerId;
+    m_nextDmacHandlerId = nextDmacHandlerId;
+    m_intcHeadOrder = intcHeadOrder;
+    m_intcTailOrder = intcTailOrder;
+    m_dmacHeadOrder = dmacHeadOrder;
+    m_dmacTailOrder = dmacTailOrder;
+    m_enabledIntcMask = enabledIntcMask;
+    m_enabledDmacMask = enabledDmacMask;
+    m_pendingIntcMask = pendingIntcMask;
+    m_pendingDmacMask = pendingDmacMask;
+    m_currentThreadId = currentThreadId;
+    m_lastRunThreadId = lastRunThreadId;
+    m_rescheduleRequested = rescheduleRequested;
+    m_timeSliceExpired = timeSliceExpired;
+    m_insideInterrupt = false;
+    m_pendingEeTimerInterrupts = pendingEeTimerInterrupts;
+    m_eeCycle = eeCycle;
+    m_sliceEndCycle = sliceEndCycle;
+    m_eventSequence = eventSequence;
+    m_invocationSequence = invocationSequence;
+    m_vsyncTick = vsyncTick;
+    m_vsyncFlagAddress = vsyncFlagAddress;
+    m_vsyncTickAddress = vsyncTickAddress;
+    m_gsVSyncCallback = gsVSyncCallback;
+    m_gsVSyncCallbackGp = gsVSyncCallbackGp;
+    m_gsVSyncCallbackSp = gsVSyncCallbackSp;
+    m_dispatchedThreadId = 0;
+    m_checkpointPending.store(false, std::memory_order_release);
+
+    {
+        std::lock_guard lock(m_eventMutex);
+        m_events.clear();
+        m_pendingEventCount.store(0u, std::memory_order_release);
+        m_pendingInvocations.clear();
+        m_deadlines.clear();
+        const auto now = pacingNow();
+        for (const SavedDeadline &saved : deadlines)
+        {
+            m_deadlines.push_back(ScheduledEvent{saved.deadlineCycle,
+                                                 now + std::chrono::nanoseconds(saved.leftNs),
+                                                 saved.event,
+                                                 saved.sequence});
+        }
+        updateNextDeadline();
+    }
+    m_eventCv.notify_one();
+    publishSnapshotNow();
+}
