+
+bool EeScheduler::saveMachine(ps2_savestate::Writer &out, std::string &whyNot)
+{
+    if (ps2_stubs::mpegMovieActive())
+    {
+        whyNot = "a movie is playing";
+        return false;
+    }
+    if (!saveState(out, whyNot))
+        return false;
+    if (!saveMemory(m_runtime.m_memory, out, whyNot))
+        return false;
+
+    out.tag(kTagRuntime);
+    {
+        std::lock_guard lock(m_runtime.m_guestHeapMutex);
+        out.put<uint32_t>(m_runtime.m_guestHeapBase);
+        out.put<uint32_t>(m_runtime.m_guestHeapEnd);
+        out.put<uint32_t>(m_runtime.m_guestHeapLimit);
+        out.put<uint32_t>(m_runtime.m_guestHeapCeiling);
+        out.put<uint32_t>(m_runtime.m_guestHeapSuggestedBase);
+        out.put<uint8_t>(m_runtime.m_guestHeapConfigured ? 1u : 0u);
+        out.put<uint32_t>(static_cast<uint32_t>(m_runtime.m_guestHeapBlocks.size()));
+        for (const PS2Runtime::GuestHeapBlock &block : m_runtime.m_guestHeapBlocks)
+        {
+            out.put<uint32_t>(block.addr);
+            out.put<uint32_t>(block.size);
+            out.put<uint8_t>(block.free ? 1u : 0u);
+        }
+    }
+    {
+        std::lock_guard lock(m_runtime.m_asyncCallbackStackMutex);
+        out.put<uint32_t>(m_runtime.m_asyncCallbackStackFloor);
+        out.put<uint32_t>(m_runtime.m_asyncCallbackStackTop);
+    }
+    {
+        std::lock_guard lock(m_runtime.m_eeKernelStateMutex);
+        out.put<uint32_t>(static_cast<uint32_t>(m_runtime.m_eeExitHandlers.size()));
+        for (const auto &[threadId, handlers] : m_runtime.m_eeExitHandlers)
+        {
+            out.put<int32_t>(threadId);
+            out.put<uint32_t>(static_cast<uint32_t>(handlers.size()));
+            for (const PS2Runtime::EeExitHandlerRegistration &handler : handlers)
+                out.put(handler);
+        }
+        out.put<uint32_t>(static_cast<uint32_t>(m_runtime.m_eeSyscallOverrides.size()));
+        for (const auto &[number, handler] : m_runtime.m_eeSyscallOverrides)
+        {
+            out.put<uint32_t>(number);
+            out.put<uint32_t>(handler);
+        }
+    }
+
+    // The emulated IOP and SPU2 (sound), as one length-prefixed blob.
+    out.tag(kTagIop);
+    std::vector<uint8_t> iop;
+    if (m_runtime.m_iopSubsystem && !m_runtime.m_iopSubsystem->native().saveState(iop, whyNot))
+        return false;
+    out.put<uint64_t>(static_cast<uint64_t>(iop.size()));
+    out.bytes(iop.data(), iop.size());
+    return true;
+}
+
+void EeScheduler::loadMachine(ps2_savestate::Reader &in)
+{
+    if (ps2_stubs::mpegMovieActive())
+        throw ps2_savestate::SaveStateError("a movie is playing");
+    loadState(in);
+    loadMemory(m_runtime.m_memory, in);
+
+    in.expectTag(kTagRuntime);
+    {
+        std::lock_guard lock(m_runtime.m_guestHeapMutex);
+        m_runtime.m_guestHeapBase = in.get<uint32_t>();
+        m_runtime.m_guestHeapEnd = in.get<uint32_t>();
+        m_runtime.m_guestHeapLimit = in.get<uint32_t>();
+        m_runtime.m_guestHeapCeiling = in.get<uint32_t>();
+        m_runtime.m_guestHeapSuggestedBase = in.get<uint32_t>();
+        m_runtime.m_guestHeapConfigured = in.get<uint8_t>() != 0u;
+        m_runtime.m_guestHeapBlocks.clear();
+        for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+        {
+            PS2Runtime::GuestHeapBlock block;
+            block.addr = in.get<uint32_t>();
+            block.size = in.get<uint32_t>();
+            block.free = in.get<uint8_t>() != 0u;
+            m_runtime.m_guestHeapBlocks.push_back(block);
+        }
+    }
+    {
+        std::lock_guard lock(m_runtime.m_asyncCallbackStackMutex);
+        m_runtime.m_asyncCallbackStackFloor = in.get<uint32_t>();
+        m_runtime.m_asyncCallbackStackTop = in.get<uint32_t>();
+    }
+    {
+        std::lock_guard lock(m_runtime.m_eeKernelStateMutex);
+        m_runtime.m_eeExitHandlers.clear();
+        for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+        {
+            const int threadId = in.get<int32_t>();
+            auto &handlers = m_runtime.m_eeExitHandlers[threadId];
+            for (uint32_t j = 0, m = in.get<uint32_t>(); j < m; ++j)
+                handlers.push_back(in.get<PS2Runtime::EeExitHandlerRegistration>());
+        }
+        m_runtime.m_eeSyscallOverrides.clear();
+        for (uint32_t i = 0, n = in.get<uint32_t>(); i < n; ++i)
+        {
+            const uint32_t number = in.get<uint32_t>();
+            m_runtime.m_eeSyscallOverrides[number] = in.get<uint32_t>();
+        }
+    }
+
+    in.expectTag(kTagIop);
+    const uint64_t iopSize = in.get<uint64_t>();
+    if (iopSize > (64ull << 20))
+        throw ps2_savestate::SaveStateError("save state IOP section is implausibly large");
+    std::vector<uint8_t> iop(static_cast<size_t>(iopSize));
+    in.bytes(iop.data(), iop.size());
+    if (!iop.empty() && m_runtime.m_iopSubsystem)
+    {
+        try
+        {
+            m_runtime.m_iopSubsystem->native().loadState(iop.data(), iop.size());
+        }
+        catch (const std::runtime_error &error)
+        {
+            throw ps2_savestate::SaveStateError(error.what());
+        }
+    }
+    copyMainContextToRuntime();
+}
