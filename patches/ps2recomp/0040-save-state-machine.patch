+    bool Iop::saveState(StateWriter &out, std::string &whyNot) const
+    {
+        if (!m_requests.empty() || !m_active.empty())
+        {
+            whyNot = "an IOP request is in flight";
+            return false;
+        }
+        if (m_inInterrupt)
+        {
+            whyNot = "the IOP is inside an interrupt";
+            return false;
+        }
+        static_assert(std::is_trivially_copyable_v<Thread> && std::is_trivially_copyable_v<Semaphore> &&
+                          std::is_trivially_copyable_v<EventFlag> && std::is_trivially_copyable_v<Alarm> &&
+                          std::is_trivially_copyable_v<HardTimer> && std::is_trivially_copyable_v<Interrupt> &&
+                          std::is_trivially_copyable_v<Server> && std::is_trivially_copyable_v<DmaChannel>,
+                      "the kernel objects are saved as they are");
+
+        out.put<uint32_t>(kIopTag);
+        out.bytes(m_bus.ram(), Bus::kRamBytes);
+        out.bytes(m_bus.scratchpad(), Bus::kScratchpadBytes);
+        out.put<uint32_t>(m_cpu.cop0Status());
+        out.put<uint64_t>(m_cycle);
+
+        out.put<uint32_t>(static_cast<uint32_t>(m_exports.size()));
+        for (const auto &[name, functions] : m_exports)
+        {
+            out.string(name);
+            out.put<uint32_t>(static_cast<uint32_t>(functions.size()));
+            out.bytes(functions.data(), functions.size() * sizeof(uint32_t));
+        }
+        out.map(m_threads);
+        out.map(m_semaphores);
+        out.map(m_eventFlags);
+        out.put<uint32_t>(static_cast<uint32_t>(m_mailboxes.size()));
+        for (const auto &[id, mailbox] : m_mailboxes)
+        {
+            out.put<int32_t>(id);
+            out.put<uint32_t>(mailbox.attr);
+            out.put<uint32_t>(mailbox.option);
+            out.put<uint32_t>(static_cast<uint32_t>(mailbox.messages.size()));
+            for (const uint32_t message : mailbox.messages)
+                out.put<uint32_t>(message);
+        }
+        out.put<uint32_t>(static_cast<uint32_t>(m_alarms.size()));
+        for (const auto &[handler, alarm] : m_alarms)
+        {
+            out.put<uint32_t>(handler);
+            out.put(alarm);
+        }
+        out.put(m_timers);
+        out.map(m_interrupts);
+        out.put<uint32_t>(static_cast<uint32_t>(m_pendingInterrupts.size()));
+        for (const uint32_t line : m_pendingInterrupts)
+            out.put<uint32_t>(line);
+        out.map(m_servers);
+        out.map(m_queues);
+        out.map(m_saved);
+        out.put(m_dma);
+        out.put<uint32_t>(static_cast<uint32_t>(m_modules.size()));
+        for (const Module &module : m_modules)
+        {
+            out.put<int32_t>(module.id);
+            out.string(module.name);
+            out.put<uint32_t>(module.base);
+            out.put<uint32_t>(module.size);
+        }
+        out.map(m_allocations);
+
+        out.put<int32_t>(m_nextId);
+        out.put<int32_t>(m_current);
+        out.put<uint64_t>(m_readySequence);
+        out.put<uint8_t>(m_reschedule ? 1u : 0u);
+        out.put<int32_t>(m_intrSuspend);
+        out.put<int32_t>(m_loaderThread);
+        out.put<uint32_t>(m_loaderResult);
+        out.put<uint32_t>(m_sifDmaId);
+
+        m_spu2.saveState(out);
+        return true;
+    }
+
+    void Iop::loadState(StateReader &in)
+    {
+        in.expect(kIopTag);
+        in.bytes(m_bus.ram(), Bus::kRamBytes);
+        in.bytes(m_bus.scratchpad(), Bus::kScratchpadBytes);
+        m_cpu.setCop0Status(in.get<uint32_t>());
+        m_cycle = in.get<uint64_t>();
+
+        m_exports.clear();
+        for (uint32_t i = 0, n = in.count(); i < n; ++i)
+        {
+            std::string name = in.string();
+            std::vector<uint32_t> functions(in.count());
+            in.bytes(functions.data(), functions.size() * sizeof(uint32_t));
+            m_exports[std::move(name)] = std::move(functions);
+        }
+        in.map(m_threads);
+        in.map(m_semaphores);
+        in.map(m_eventFlags);
+        m_mailboxes.clear();
+        for (uint32_t i = 0, n = in.count(); i < n; ++i)
+        {
+            const int32_t id = in.get<int32_t>();
+            Mailbox &mailbox = m_mailboxes[id];
+            mailbox.attr = in.get<uint32_t>();
+            mailbox.option = in.get<uint32_t>();
+            for (uint32_t j = 0, m = in.count(); j < m; ++j)
+                mailbox.messages.push_back(in.get<uint32_t>());
+        }
+        m_alarms.clear();
+        for (uint32_t i = 0, n = in.count(); i < n; ++i)
+        {
+            const uint32_t handler = in.get<uint32_t>();
+            m_alarms.emplace(handler, in.get<Alarm>());
+        }
+        m_timers = in.get<std::array<HardTimer, 6>>();
+        in.map(m_interrupts);
+        m_pendingInterrupts.clear();
+        for (uint32_t i = 0, n = in.count(); i < n; ++i)
+            m_pendingInterrupts.push_back(in.get<uint32_t>());
+        in.map(m_servers);
+        in.map(m_queues);
+        in.map(m_saved);
+        m_dma = in.get<std::array<DmaChannel, 2>>();
+        m_modules.clear();
+        for (uint32_t i = 0, n = in.count(); i < n; ++i)
+        {
+            Module module;
+            module.id = in.get<int32_t>();
+            module.name = in.string();
+            module.base = in.get<uint32_t>();
+            module.size = in.get<uint32_t>();
+            m_modules.push_back(std::move(module));
+        }
+        in.map(m_allocations);
+
+        m_nextId = in.get<int32_t>();
+        m_current = in.get<int32_t>();
+        m_readySequence = in.get<uint64_t>();
+        m_reschedule = in.get<uint8_t>() != 0u;
+        m_intrSuspend = in.get<int32_t>();
+        m_loaderThread = in.get<int32_t>();
+        m_loaderResult = in.get<uint32_t>();
+        m_sifDmaId = in.get<uint32_t>();
+        m_requests.clear();
+        m_active.clear();
+        m_inInterrupt = false;
+
+        m_spu2.loadState(in);
+    }
 }
