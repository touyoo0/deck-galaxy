diff --git a/ps2xRuntime/include/runtime/ps2_savestate.h b/ps2xRuntime/include/runtime/ps2_savestate.h
new file mode 100644
index 0000000..1c30528
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_savestate.h
@@ -0,0 +1,95 @@
+#ifndef PS2_SAVESTATE_H
+#define PS2_SAVESTATE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+// A flat byte stream for save states. Plain data goes through put/get; a
+// container writes its size first. A Reader that runs past its end throws
+// SaveStateError, so a truncated or foreign file fails the load instead of
+// reading beyond the buffer.
+namespace ps2_savestate
+{
+struct SaveStateError : std::runtime_error
+{
+    using std::runtime_error::runtime_error;
+};
+
+class Writer
+{
+public:
+    template <typename T>
+    void put(const T &value)
+    {
+        static_assert(std::is_trivially_copyable_v<T>, "put needs plain data");
+        bytes(&value, sizeof(T));
+    }
+
+    void bytes(const void *data, size_t size)
+    {
+        const auto *p = static_cast<const uint8_t *>(data);
+        m_buffer.insert(m_buffer.end(), p, p + size);
+    }
+
+    // A section tag, so a reader that has drifted fails at the next boundary
+    // instead of decoding garbage.
+    void tag(uint32_t value) { put(value); }
+
+    [[nodiscard]] std::vector<uint8_t> &buffer() { return m_buffer; }
+    [[nodiscard]] const std::vector<uint8_t> &buffer() const { return m_buffer; }
+
+private:
+    std::vector<uint8_t> m_buffer;
+};
+
+class Reader
+{
+public:
+    Reader(const uint8_t *data, size_t size) : m_data(data), m_size(size) {}
+
+    template <typename T>
+    T get()
+    {
+        static_assert(std::is_trivially_copyable_v<T>, "get needs plain data");
+        T value;
+        bytes(&value, sizeof(T));
+        return value;
+    }
+
+    void bytes(void *out, size_t size)
+    {
+        if (size > m_size - m_pos)
+            throw SaveStateError("save state is truncated");
+        std::memcpy(out, m_data + m_pos, size);
+        m_pos += size;
+    }
+
+    void expectTag(uint32_t value)
+    {
+        if (get<uint32_t>() != value)
+            throw SaveStateError("save state section mismatch");
+    }
+
+    [[nodiscard]] size_t remaining() const { return m_size - m_pos; }
+
+private:
+    const uint8_t *m_data;
+    size_t m_size;
+    size_t m_pos = 0;
+};
+
+constexpr uint32_t makeTag(char a, char b, char c, char d)
+{
+    return static_cast<uint32_t>(static_cast<uint8_t>(a)) |
+           (static_cast<uint32_t>(static_cast<uint8_t>(b)) << 8) |
+           (static_cast<uint32_t>(static_cast<uint8_t>(c)) << 16) |
+           (static_cast<uint32_t>(static_cast<uint8_t>(d)) << 24);
+}
+} // namespace ps2_savestate
+
+#endif // PS2_SAVESTATE_H
