diff --git a/ps2xIOP/src/lle/state_stream.h b/ps2xIOP/src/lle/state_stream.h
new file mode 100644
index 0000000..2101ff9
--- /dev/null
+++ b/ps2xIOP/src/lle/state_stream.h
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace ps2x::iop::lle
+{
+    // A flat byte stream for the IOP's save state. Plain data goes through
+    // put/get; a container writes its size first, and a Reader that runs past
+    // its end, or reads a size no state of this build could hold, throws.
+    class StateWriter
+    {
+    public:
+        template <typename T>
+        void put(const T &value)
+        {
+            static_assert(std::is_trivially_copyable_v<T>, "put needs plain data");
+            bytes(&value, sizeof(T));
+        }
+
+        void bytes(const void *data, size_t size)
+        {
+            const auto *p = static_cast<const uint8_t *>(data);
+            m_buffer.insert(m_buffer.end(), p, p + size);
+        }
+
+        void string(const std::string &text)
+        {
+            put<uint32_t>(static_cast<uint32_t>(text.size()));
+            bytes(text.data(), text.size());
+        }
+
+        template <typename Key, typename Value>
+        void map(const std::map<Key, Value> &values)
+        {
+            put<uint32_t>(static_cast<uint32_t>(values.size()));
+            for (const auto &[key, value] : values)
+            {
+                put(key);
+                put(value);
+            }
+        }
+
+        std::vector<uint8_t> &buffer() { return m_buffer; }
+
+    private:
+        std::vector<uint8_t> m_buffer;
+    };
+
+    class StateReader
+    {
+    public:
+        StateReader(const uint8_t *data, size_t size) : m_data(data), m_size(size) {}
+
+        template <typename T>
+        T get()
+        {
+            static_assert(std::is_trivially_copyable_v<T>, "get needs plain data");
+            T value;
+            bytes(&value, sizeof(T));
+            return value;
+        }
+
+        void bytes(void *out, size_t size)
+        {
+            if (size > m_size - m_pos)
+                throw std::runtime_error("IOP state is truncated");
+            std::memcpy(out, m_data + m_pos, size);
+            m_pos += size;
+        }
+
+        // A count that sizes a container: bounded, so a damaged file cannot
+        // ask for gigabytes.
+        uint32_t count(uint32_t limit = 1u << 20)
+        {
+            const uint32_t value = get<uint32_t>();
+            if (value > limit)
+                throw std::runtime_error("IOP state holds an implausible count");
+            return value;
+        }
+
+        std::string string()
+        {
+            const uint32_t length = count(4096u);
+            std::string text(length, '\0');
+            bytes(text.data(), length);
+            return text;
+        }
+
+        template <typename Key, typename Value>
+        void map(std::map<Key, Value> &values)
+        {
+            values.clear();
+            for (uint32_t i = 0, n = count(); i < n; ++i)
+            {
+                const Key key = get<Key>();
+                values.emplace(key, get<Value>());
+            }
+        }
+
+        void expect(uint32_t tag)
+        {
+            if (get<uint32_t>() != tag)
+                throw std::runtime_error("IOP state section mismatch");
+        }
+
+    private:
+        const uint8_t *m_data;
+        size_t m_size;
+        size_t m_pos = 0;
+    };
+}
